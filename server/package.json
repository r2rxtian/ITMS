{
  "name": "@stockhub/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "npm run build && node dist/scripts/initialize-database.js",
    "db:check": "npm run build && node dist/scripts/check-database.js",
    "user:create-admin": "npm run build && node dist/scripts/create-admin.js"
    ,"user:reset-admin": "npm run build && node dist/scripts/reset-admin-password.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mssql": "^11.0.1",
    "msnodesqlv8": "^5.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
